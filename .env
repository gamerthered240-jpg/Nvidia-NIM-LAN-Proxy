# ═══════════════════════════════════════════════════════════════
#  Nvidia NIM → OpenAI LAN Proxy  —  Configuration
# ═══════════════════════════════════════════════════════════════

PROXY_API_KEY=hi
PROXY_HOST=0.0.0.0
PROXY_PORT=8016

NVIDIA_API_KEY=API_KEY_HERE

# NOTE: Do NOT include /v1 here — the proxy appends it automatically
NVIDIA_BASE_URL=https://integrate.api.nvidia.com

# MODELS=(model label):(model id)
MODELS=Step3.7Flash:stepfun-ai/step-3.7-flash
MODELS=KimiK2.6:moonshotai/kimi-k2.6
MODELS=DeepSeekV4Flash:deepseek-ai/deepseek-v4-flash

# Request timeout in seconds
REQUEST_TIMEOUT=60
STRIP_PARAMS=logprobs,top_logprobs,tools,tool_choice,response_format,n
MAP_PARAMS=max_completion_tokens:max_tokens
LOG_LEVEL=INFO